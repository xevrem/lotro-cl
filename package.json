{
  "name": "lotro-cl",
  "version": "0.1.1",
  "private": true,
  "homepage": "https://xevrem.github.io/lotro-cl",
  "scripts": {
    "build": "npm run setup:publish;node build.mjs",
    "postinstall": "npm run setup:start",
    "publish": "npm run build",
    "setup:publish": "echo \"setting up publish...\";npm run setup:publish:dirs;npm run setup:publish:files;npm run setup:publish:img;npm run setup:publish:fonts;echo \"publish setup done.\"",
    "setup:publish:dirs": "mkdir -p ./public/images;mkdir -p ./public/data",
    "setup:publish:files": "cp ./src/index.html ./public/.;cp ./src/manifest.json ./public/.;cp ./src/data/* ./public/data/.",
    "setup:publish:fonts": "cp ./src/fonts.css ./public/.;cp ./src/lotro.woff ./public/.",
    "setup:publish:img": "cp ./images/* ./public/images/.;cp ./src/favicon.ico ./public/.",
    "setup:start": "echo \"setting up start...\";npm run setup:start:dirs;npm run setup:start:files;npm run setup:start:img;npm run setup:start:fonts;echo \"start setup done.\"",
    "setup:start:dirs": "mkdir -p ./build/images;mkdir -p ./build/data",
    "setup:start:files": "cp ./src/index.html ./build/.;cp ./src/manifest.json ./build/.;cp ./src/data/* ./build/data/.",
    "setup:start:fonts": "cp ./src/fonts.css ./build/.;cp ./src/lotro.woff ./build/.",
    "setup:start:img": "cp ./images/* ./build/images/.;cp ./src/favicon.ico ./build/.",
    "start": "npm run setup:start;node start.mjs",
    "deploy": "npm run setup:publish && pnpm gh-pages -d ./public"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/eslint-parser": "^7.27.5",
    "@babel/eslint-plugin": "^7.27.1",
    "@types/node": "^24.0.7",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.5",
    "esbuild-inline-sass": "^0.4.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.2.0",
    "prettier": "^3.6.1",
    "sass": "^1.81.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
