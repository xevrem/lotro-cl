{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "WebWorker", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": "src",
    "rootDirs": ["src"],
    "jsx": "react-jsxdev",
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules/**/*"]
}
